<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Projet_WinUI_CombatDonjon.Views.PageNouvPartie"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Projet_WinUI_CombatDonjon.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Projet_WinUI_CombatDonjon.ViewModels"
    mc:Ignorable="d">

    <Grid Background="Black">
        <StackPanel
            x:Name="BoiteNouvPartie"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#606060"
            BorderBrush="#444444"
            BorderThickness="5"
            CornerRadius="100"
            Spacing="20">
            <StackPanel
                Padding="20"
                HorizontalAlignment="Center"
                Spacing="20">
                <TextBlock
                    Margin="10,10,10,10"
                    Padding="10"
                    AutomationProperties.HeadingLevel="Level1"
                    FontFamily="Bahnschrift"
                    FontSize="52"
                    FontWeight="Bold"
                    Foreground="White"
                    IsColorFontEnabled="True"
                    Style="{StaticResource DisplayTextBlockStyle}"
                    Text="Projet WinUI : Combat Donjon" />

                <TextBlock
                    FontFamily="Bahnschrift"
                    FontSize="20"
                    Foreground="White"
                    Text="Liste des personnages" />

                <ListView
                    AutomationProperties.Name="Liste des Personnages"
                    ItemsSource="{x:Bind ViewModel.PersoVMs, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PersoSelect, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PersoVM">
                            <StackPanel
                                Width="Justify"
                                Padding="10"
                                HorizontalAlignment="Left"
                                Background="#606060"
                                BorderBrush="#333333"
                                BorderThickness="4"
                                Orientation="Horizontal">
                                <TextBlock
                                    Padding="4"
                                    FontFamily="Bahnschrift"
                                    FontSize="20"
                                    Foreground="White"
                                    Text="{x:Bind Nom, Mode=OneWay}" />
                                <TextBlock
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    FontFamily="Bahnschrift"
                                    FontSize="20"
                                    Foreground="White"
                                    Text="{x:Bind Classe.ClasseNom, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Button_Nv_Perso_Click" Content="Nouveau Personnage" />
                    <Button Click="Button_Modif_Perso_Click" Content="Modifier le personnage" />
                    <Button Click="Button_Supprim_Perso_Click" Content="Supprimer le personnage" />
                    <Button Click="Button_nv_PersoD_Click" Content="Default le personnage" />
                </StackPanel>


                <Button
                    x:Name="Button_Nv_Partie_Fin"
                    Width="200"
                    Padding="10"
                    HorizontalAlignment="Center"
                    Background="#929292"
                    BorderBrush="#444444"
                    BorderThickness="2"
                    Click="Button_Nv_Partie_Fin_Click"
                    CornerRadius="25">
                    <TextBlock
                        FontSize="20"
                        Foreground="White"
                        Text="Nouvelle Partie" />
                </Button>



            </StackPanel>


        </StackPanel>
    </Grid>
</Page>
