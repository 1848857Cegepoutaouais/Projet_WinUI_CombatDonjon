<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Projet_WinUI_CombatDonjon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Projet_WinUI_CombatDonjon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Projet_WinUI_CombatDonjon.Views"
    Title="Projet_WinUI_CombatDonjon"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        AlwaysShowHeader="False"
        BackRequested="NavView_BackRequested"
        IsPaneVisible="False"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <!--  Tag : nom de la classe de la page  -->
            <NavigationViewItem
                Content="Page Titre"
                IsSelected="True"
                Tag="Projet_WinUI_CombatDonjon.Views.PageTitre">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA8A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--  Page de création de la partie  -->
            <NavigationViewItem Content="Nouvelle Partie" Tag="Projet_WinUI_CombatDonjon.Views.PageNouvPartie">
                <!--  Utilisation d'une icône personnalisée  -->
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--  Page de création de personnage  -->
            <NavigationViewItem Content="Nouveau Perso" Tag="Projet_WinUI_CombatDonjon.Views.PageNouvPerso">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA8A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--  Page de chargement de parties  -->
            <NavigationViewItem Content="Charger une Partie" Tag="Projet_WinUI_CombatDonjon.Views.PageChargerPartie">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA8A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--  Page de Combat  -->
            <NavigationViewItem Content="Page de Combat" Tag="Projet_WinUI_CombatDonjon.Views.PageCombat">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA8A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame
            x:Name="ContentFrame"
            Background="Black"
            Navigated="ContentFrame_Navigated"
            NavigationFailed="ContentFrame_NavigationFailed" />

    </NavigationView>
</Window>
