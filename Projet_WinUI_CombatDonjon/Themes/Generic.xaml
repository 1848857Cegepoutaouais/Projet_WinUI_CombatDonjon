<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projet_WinUI_CombatDonjon">

    <Style TargetType="local2:PersoVM" xmlns:local2="using:Projet_WinUI_CombatDonjon.ViewModels">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:PersoVM">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
