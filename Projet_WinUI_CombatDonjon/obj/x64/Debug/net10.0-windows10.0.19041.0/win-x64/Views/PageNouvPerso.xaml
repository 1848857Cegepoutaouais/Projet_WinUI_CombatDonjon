<?xml version="1.0" encoding="utf-8" ?>
<Page x:ConnectionId='1'
    x:Class="Projet_WinUI_CombatDonjon.Views.PageNouvPerso"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Projet_WinUI_CombatDonjon.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Black">
        <StackPanel x:ConnectionId='2'
            x:Name="BoiteNouvPerso"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#606060"
            BorderBrush="#444444"
            BorderThickness="5"
            CornerRadius="100"
            Spacing="20">
            <StackPanel
                Padding="20"
                HorizontalAlignment="Center"
                Spacing="20">
                <TextBlock
                    Margin="10,10,10,10"
                    Padding="10"
                    AutomationProperties.HeadingLevel="Level1"
                    FontFamily="Bahnschrift"
                    FontSize="52"
                    FontWeight="Bold"
                    Foreground="White"
                    IsColorFontEnabled="True"
                    Style="{StaticResource DisplayTextBlockStyle}"
                    Text="Projet WinUI : Combat Donjon" />

                <StackPanel
                    Margin="10,10,10,10"
                    Padding="10"
                    Spacing="10">
                    <TextBlock x:ConnectionId='8'
                        Margin="10,10,10,10"
                        Padding="10"
                        AutomationProperties.HeadingLevel="Level3"
                        FontFamily="Bahnschrift"
                        FontSize="32"
                        Foreground="White"
                        IsColorFontEnabled="True"
                                                                     />
                </StackPanel>
                <TextBox x:ConnectionId='3'
                    Header="Nom du personnage"
                    PlaceholderText="Nom du personnage"
                                                                                                                 />

                <ComboBox x:ConnectionId='4'
                    Width="200"
                    Header="Classe du personnage"
                                                        
                                                                     />


                <ItemsView x:ConnectionId='5' Foreground="Red"                                                                            >
                    <ItemsView.Resources>
                        <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
                    </ItemsView.Resources>
                </ItemsView>

                <!--
                <ListView
                    AutomationProperties.Name="Liste des Personnages"
                    ItemsSource="{x:Bind ViewModel.PersoVMs, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PersoSelect, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PersoVM">
                            <TextBlock
                            Padding="4"
                            FontFamily="Bahnschrift"
                            FontSize="20"
                            Text="{x:Bind Nom, Mode=OneWay}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>-->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:ConnectionId='6'                                  Content="Créer le Personnage" />
                    <Button x:ConnectionId='7'                                    Content="Annuler" />
                </StackPanel>



            </StackPanel>
            <TextBlock Text="asd" />
        </StackPanel>
    </Grid>
</Page>

